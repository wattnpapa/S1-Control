# Vorlage fuer `.env` neben docker-compose.yml und docker-compose.internet.yml.
# Nach `.env` kopieren und ausfuellen; `.env` ist in .gitignore und wird nicht
# eingecheckt.

# --- docker-compose.yml, nur Weg B (Docker haengt das SMB-Share selbst ein) ---
S1_NAS_HOST=nas.fuest.lan
S1_NAS_FREIGABE=S1-Control
S1_NAS_BENUTZER=s1control
S1_NAS_PASSWORT=

# --- docker-compose.internet.yml (Bereitstellung im Internet, ADR-006) ---
# Der Name, unter dem der Server erreichbar ist; Caddy holt dafuer das Zertifikat.
S1_DOMAIN=s1.example.org
# Ein gemeinsamer Zugang fuer alle. Das Passwort hat mindestens 12 Zeichen;
# enthaelt es ein `$`, in einfache Anfuehrungszeichen setzen.
S1_WEB_ANMELDENAME=fuest
S1_WEB_PASSWORT=
# Lebensdauer einer Sitzung ab letzter Nutzung, in Stunden.
S1_WEB_SITZUNG_H=12
