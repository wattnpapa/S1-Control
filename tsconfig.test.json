{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    },
    "outDir": ".tsbuild/test",
    "tsBuildInfoFile": ".tsbuild/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "test/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ]
}
