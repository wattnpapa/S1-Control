{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist-electron",
    "resolveJsonModule": true,
    "tsBuildInfoFile": ".tsbuild/tsconfig.main.tsbuildinfo"
  },
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.json",
    "src/shared/**/*.ts",
    "drizzle.config.ts"
  ]
}
